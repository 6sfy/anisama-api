# anisama-api configuration
# Copy this file to `.env` and adjust the values:
#   cp .env.example .env

# Server port
PORT=20100

# Bind address (0.0.0.0 = all interfaces)
HOST=0.0.0.0

# Data directory for catalog/cache (default: <project_root>/data)
#ANISAMA_DATA_DIR=/var/lib/anisama

# Path to Playwright Chromium executable (required for MyFluneo resolution)
#ANISAMA_PLAYWRIGHT_EXECUTABLE_PATH=/usr/bin/chromium