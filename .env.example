# anisama-api configuration
# Copy this file to `.env` and adjust the values:
#   cp .env.example .env

# Server port
PORT=20100

# Bind address — keep 0.0.0.0 inside Docker/Pterodactyl.
# Never put the public IP here: it is not assigned inside the container.
HOST=0.0.0.0

# Data directory for catalog/cache (default: <project_root>/data)
#ANISAMA_DATA_DIR=/var/lib/anisama

# Path to Playwright Chromium executable (optional, historical MyFluneo/AnimoFlix only)
#ANISAMA_PLAYWRIGHT_EXECUTABLE_PATH=/usr/bin/chromium
# ── Fast engine (anime_engine) ──
# 1 = actif (défaut) — anime-sama + franime via extraction directe (rapide)
# 0 = désactiver le fast path et revenir au pipeline historique
ANISAMA_FAST_ENGINE=1

# Proxy sortant du moteur (utile si l'IP du serveur est bloquée par Cloudflare)
#ENGINE_PROXY=http://host:port

# Timeout réseau du moteur en secondes
#ENGINE_TIMEOUT=25

# --- Security ---
# Per-IP rate limits (requests per ANISAMA_RATE_LIMIT_WINDOW seconds).
# 0 disables a tier. Heavy = search/episodes/resolve, resolve = resolve-episode.
#ANISAMA_RATE_LIMIT_GLOBAL=60
#ANISAMA_RATE_LIMIT_HEAVY=20
#ANISAMA_RATE_LIMIT_EPISODES=20
#ANISAMA_RATE_LIMIT_RESOLVE=5
#ANISAMA_RATE_LIMIT_WINDOW=60

# Optional bearer token protecting expensive endpoints (/api/v2/episodes,
# /resolve, /resolve-episode, /seasons, /hosts). Empty = public API.
#ANISAMA_API_TOKEN=

# Client IP / proxy trust. auto = trust CF-Connecting-IP / X-Forwarded-For
# only from loopback/private/Cloudflare peers; 1 = always; 0 = never.
#ANISAMA_TRUST_PROXY=auto
# Extra trusted proxy IPs or CIDRs (comma-separated), e.g. a local Caddy.
#ANISAMA_TRUSTED_PROXIES=
# Origin lock: require X-Origin-Secret on every request. Add the header with
# a Cloudflare Transform Rule and firewall the origin to Cloudflare IPs.
#ANISAMA_ORIGIN_SECRET=

# Comma-separated browser origins allowed to call the API, or * for any.
# Same-origin requests (the bundled docs) never need this. Default:
# https://anisama.sexcaller.lol + localhost.
#ANISAMA_CORS_ORIGINS=

# Advertise the Voiranime source (set 0 to hide it).
#ANISAMA_ENABLE_VOIRANIME=1
